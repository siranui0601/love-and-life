>
          </div>
          <div class="tutorial-progress-ring" aria-label="チュートリアル完了数">
            <strong id="tutorialCompletedCount">0 / 10</strong><span>完了</span>
          </div>
          <button class="primary-action compact tutorial-recommended" id="tutorialRecommendedButton" type="button"><span>おすすめから始める</span><span>→</span></button>
        </div>
        <div id="tutorialLessonGroups" class="tutorial-lesson-groups"></div>
      </div>

      <div class="tutorial-lesson" id="tutorialLesson" hidden>
        <div class="tutorial-lesson-toolbar">
          <button class="tutorial-list-back" id="tutorialLessonBack" type="button"><span>‹</span> レッスン一覧</button>
          <span id="tutorialLessonPosition">LESSON</span>
        </div>
        <div class="tutorial-layout">
          <aside class="tutorial-guide-card">
            <div class="tutorial-lesson-heading">
              <span id="tutorialLessonCategory"></span>
              <h3 id="tutorialLessonTitle"></h3>
              <p id="tutorialLessonSummary"></p>
            </div>
            <button class="tutorial-disclosure" id="tutorialDisclosureButton" type="button" aria-expanded="true" aria-controls="tutorialExplanation">
              <span>説明と入力例</span><span class="tutorial-disclosure-chevron">⌃</span>
            </button>
            <div class="tutorial-explanation" id="tutorialExplanation">
              <ol id="tutorialSteps"></ol>
              <div class="tutorial-worked-example"><small>入力例</small><strong id="tutorialExample"></strong></div>
              <div class="tutorial-key-chips" id="tutorialKeyChips" aria-label="このレッスンで使う記号"></div>
            </div>
            <p class="tutorial-auto-note">入力を始めると説明は自動で折り畳まれます。上のボタンでいつでも読み直せます。</p>
            <button class="secondary-action tutorial-exit" id="tutorialExitButton" type="button">このレッスンを終了</button>
          </aside>
          <div class="tutorial-calculator-column">
            <div id="tutorialCalculatorMount"></div>
            <p class="tutorial-calculator-note">灰色のキーは、このレッスンでは使いません。本番ではすべて利用できます。</p>
          </div>
        </div>
      </div>
    </section>

    <section class="screen" data-screen="online"'''
html = html[:old_tutorial.start()] + new_tutorial + html[old_tutorial.end():]
html = html.replace('/ten-freely/app.js', '/10を自由に/app.js')
html = html.replace('/ten-freely/online.js', '/10を自由に/online.js')
html = html.replace('  <script type="module" src="/ten-freely/ranking.js"></script>\n', '')
(new_pub/'index.html').write_text(html)

