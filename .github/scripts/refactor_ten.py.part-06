/ten-freely/expression-engine.js', '../../public/10を自由に/expression-engine.js')
server_online = server_online.replace('import { readUserSessionFromCookieHeader } from "../auth/session.js";', 'import { readUserSessionFromCookieHeader } from "./storage.js";')
server_online = server_online.replace('} from "../../foundation/ten-freely-sheets.js";', '} from "./storage.js";')
(new_src/'online.js').write_text(server_online)

# Mount and static paths.
shared = (root/'src'/'server'/'shared'/'index.js').read_text().replace('import { mountTenFreelyRoutes } from "../ten-freely/index.js";', 'import { mountTenFreelyRoutes } from "../../10を自由に/index.js";')
(root/'src'/'server'/'shared'/'index.js').write_text(shared)
server_app = (root/'src'/'server'/'app.js').read_text().replace('path.join(publicDirectory, "ten-freely")', 'path.join(publicDirectory, "10を自由に")')
(root/'src'/'server'/'app.js').write_text(server_app)

# Remove the obsolete parallel directory trees and tiny one-off entry files.
for obsolete in [
    root/'public'/'ten-freely',
    root/'src'/'server'/'ten-freely',
]:
    if obsolete.exists(): shutil.rmtree(obsolete)
for obsolete in [
    root/'public'/'ten-freely-entry.css',
    root/'public'/'ten-freely-entry.js',
    root/'src'/'foundation'/'ten-freely-sheets.js',
    root/'src'/'server'/'auth'/'session.js',
    root/'.github'/'workflows'/'ten-freely-refactor-export.yml',
    root/'.github'/'scripts'/'refactor_ten.py',
]:
    if obsolete.exists(): obsolete.unlink()
for chunk in (root/'.github'/'scripts').glob('refactor_ten.py.part-*'):
    chunk.unlink()
# Remove now-empty auth/scripts directories without touching unrelated files.
for directory in [root/'src'/'server'/'auth', root/'.github'/'scripts']:
    try: directory.rmdir()
    except OSError: pass

print('refactor complete')
