          ${next ? `<button class="modal-primary" type="button" data-next-tutorial>次のおすすめ：${escapeHtml(next.title)}</button>` : ""}
            <button class="modal-secondary" type="button" data-tutorial-list>レッスン一覧へ</button>
          </div>`, { closeable: false });
        refs.modalContent.querySelector("[data-next-tutorial]")?.addEventListener("click", () => { closeModal(true); startTutorialLesson(next.id); });
        refs.modalContent.querySelector("[data-tutorial-list]").addEventListener("click", () => { closeModal(true); showTutorialHub(); });
      } catch (error) { instance.setResult(error.message, "error"); }
    },
  });
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function leaveTutorialLesson() {
  if (!activeTutorialId) return showTutorialHub();
  showTutorialHub();
}

'''
app = app[:start] + new_tutorial_js + app[end:]
# Replace bottom tutorial listeners.
app = app.replace('''refs.tutorialNextButton.addEventListener("click", advanceTutorial);\nrefs.tutorialSkipButton.addEventListener("click", () => { if (tutorialIndex >= tutorialSteps.length - 1) advanceTutorial(); else startTutorial(tutorialIndex + 1); });''',
'''refs.tutorialLessonGroups.addEventListener("click", (event) => {\n  const card = event.target.closest("[data-tutorial-id]");\n  if (card) startTutorialLesson(card.dataset.tutorialId);\n});\nrefs.tutorialRecommendedButton.addEventListener("click", () => startTutorialLesson(refs.tutorialRecommendedButton.dataset.tutorialId));\nrefs.tutorialLessonBack.addEventListener("click", leaveTutorialLesson);\nrefs.tutorialExitButton.addEventListener("click", leaveTutorialLesson);\nrefs.tutorialDisclosureButton.addEventListener("click", () => {\n  setTutorialExplanationExpanded(refs.tutorialDisclosureButton.getAttribute("aria-expanded") !== "true", { manual: true });\n});''')

# Merge ranking module into app, adapted to local helpers.
ranking = (old_pub/'ranking.js').read_text()
ranking = ranking.replace('const app = window.tenFreelyApp;\nif (!app) throw new Error("tenFreelyApp bridge is not ready");\n\n', '')
ranking = ranking.replace('app.formatDuration', 'formatDuration')
ranking = ranking.replace('function escapeHtml(value) {\n  return String(value ?? "").replace(/[&<>"\']/gu, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", \'"\': "&quot;", "\'": "&#39;" }[char]));\n}\n\n', '')
# Append before app initialization calls, after window bridge.
insert_at = app.index('for (const button of document.querySelectorAll("[data-open-screen]"))')
app = app[:insert_at] + '\n// 条件別ランキングは小規模なので、画面制御と同じモジュールへ統合。\n' + ranking + '\n' + app[insert_at:]
(new_pub/'app.js').write_text(app)

# ---------- Unified CSS ----------
base_css = (old_pub/'styles.css').read_text()
online_css = (old_pub/'online-ranking.css').read_text()
new_tutorial_css = r'''

/* --- Optional, selectable tutorial lessons --- */
.tutorial-layout {
  display: grid;
  grid-template-columns: minmax(280px, .88fr) minmax(0, 1.12fr);
  gap: 18px;
  align-items: start;
}
.tutorial-hub, .tutorial-lesson { width: min(980px, 100%); margin: 0 auto; }
.tutorial-hub-intro {
  display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px; align-items: center;
  padding: clamp(22px, 4vw, 36px); border: 1px solid rgba(255,159,10,.26); border-radius: var(--radius-xl);
  background: linear-gradient(145deg, rgba(255,159,10,.13), rgba(255,255,255,.035)); box-shadow: var(--shadow), inset 0 1px rgba(255,255,255,.07);
}
.tutorial-hub-kicker { color: var(--orange-bright); font-size: 9px; font-weight: 850; letter-spacing: .18em; }
.tutorial-hub-intro h3 { margin: 8px 0 10px; font-size: clamp(25px, 4vw, 38px); letter-spacing: -.04em; }
.tutorial-hub-intro p { max-width: 680px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.8; }
.tutorial-progress-ring { display: grid; place-items: center; width: 92px; height: 92px; border: 1px solid rgba(255,159,10,.4); border-radius: 50%; background: rgba(0,0,0,.18); box-shadow: inset 0 0 24px rgba(255,159,10,.08); }
.tutorial-progress-ring strong { font-size: 18px; font-variant-numeric: tabular-nums; }
.tutorial-progress-ring span { margin-top: -17px; color: var(--dim); font-size: 9px; }
.tutorial-recommended { grid-column: 1 / -1; width: 100%; }
.tutorial-lesson-groups { display: grid; gap: 28px; margin-top: 28px; }
.tutorial-category { padding: clamp(18px, 3vw, 28px); border: 1px solid var(--line); border-radius: var(--radius-xl); background: rgba(18,18,20,.7); }
.tutorial-category-heading { display: flex; align-items: end; justify-content: space-between; margin-bottom: 15px; }
.tutorial-category-heading small { color: var(--orange-bright); font-size: 8px; font-weight: 850; letter-spacing: .18em; }
.tutorial-category-heading h3 { margin: 4px 0 0; font-size: 22px; }
.tutorial-category-heading > span { color: var(--dim); font-size: 12px; font-variant-numeric: tabular-nums; }
.tutorial-card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.tutorial-card {
  display: grid; grid-template-columns: 48px minmax(0,1fr) 28px; gap: 13px; align-items: center; min-height: 116px; padding: 15px;
  border: 1px solid var(--line); border-radius: 20px; background: rgba(255,255,255,.035); text-align: left; cursor: pointer; transition: transform .18s ease, border-color .18s ease, background .18s ease;
}
.tutorial-card:hover { transform: translateY(-2px); border-color: rgba(255,255,255,.22); background: rgba(255,255,255,.06); }
.tutorial-card:active { transform: scale(.985); }
.tutorial-card.is-complete { border-color: rgba(48,209,88,.28); background: rgba(48,209,88,.055); }
.tutorial-card-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 16px; background: rgba(255,159,10,.12); color: var(--orange-bright); font-size: 17px; font-weight: 850; }
.tutorial-card.is-complete .tutorial-card-icon { background: rgba(48,209,88,.1); color: var(--green); }
.tutorial-card-copy { display: flex; flex-direction: column; min-width: 0; }
.tutorial-card-copy small { color: var(--dim); font-size: 8px; font-weight: 800; letter-spacing: .1em; }
.tutorial-card-copy strong { margin: 5px 0; font-size: 16px; }
.tutorial-card-copy > span { color: var(--muted); font-size: 11px; line-height: 1.55; }
.tutorial-card-state { color: var(--dim); font-size: 20px; }
.tutorial-card.is-complete .tutorial-card-state { color: var(--green); }
.tutorial-lesson-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.tutorial-list-back { min-height: 44px; padding: 0 12px; border: 0; border-radius: 14px; background: transparent; color: var(--orange-bright); cursor: pointer; }
.tutorial-list-back span { margin-right: 3px; font-size: 27px; vertical-align: -2px; }
.tutorial-lesson-toolbar > span { color: var(--dim); font-size: 9px; font-weight: 800; letter-spacing: .12em; }
.tutorial-guide-card {
  position: sticky; top: 18px; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-xl);
  