 background: var(--surface); backdrop-filter: blur(28px); -webkit-backdrop-filter: blur(28px); box-shadow: var(--shadow), inset 0 1px rgba(255,255,255,.06);
}
.tutorial-lesson-heading { padding: 25px 25px 18px; }
.tutorial-lesson-heading > span { color: var(--orange-bright); font-size: 10px; font-weight: 850; }
.tutorial-lesson-heading h3 { margin: 7px 0 10px; font-size: clamp(25px, 4vw, 36px); letter-spacing: -.04em; }
.tutorial-lesson-heading p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.75; }
.tutorial-disclosure { display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 50px; padding: 0 25px; border: solid var(--line); border-width: 1px 0; background: rgba(255,255,255,.035); font-size: 12px; font-weight: 750; cursor: pointer; }
.tutorial-disclosure-chevron { color: var(--orange-bright); font-size: 16px; }
.tutorial-explanation { padding: 20px 25px; }
.tutorial-explanation[hidden] { display: none; }
.tutorial-explanation ol { display: grid; gap: 10px; margin: 0; padding-left: 21px; color: var(--muted); font-size: 12px; line-height: 1.7; }
.tutorial-explanation li::marker { color: var(--orange); font-weight: 800; }
.tutorial-worked-example { display: flex; flex-direction: column; gap: 7px; margin-top: 17px; padding: 14px 15px; border-radius: 15px; background: rgba(255,159,10,.075); }
.tutorial-worked-example small { color: var(--orange-bright); font-size: 9px; font-weight: 800; }
.tutorial-worked-example strong { font-size: 15px; line-height: 1.55; }
.tutorial-key-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 13px; }
.tutorial-key-chips span { min-width: 32px; padding: 6px 9px; border: 1px solid var(--line); border-radius: 9px; background: rgba(255,255,255,.045); color: var(--muted); font-size: 11px; text-align: center; }
.tutorial-auto-note { margin: 0; padding: 14px 25px 0; color: var(--dim); font-size: 10px; line-height: 1.6; }
.tutorial-exit { width: calc(100% - 50px); margin: 16px 25px 25px; }
.tutorial-calculator-column { min-width: 0; }
.tutorial-calculator-note { margin: 10px 8px 0; color: var(--dim); font-size: 10px; line-height: 1.55; text-align: center; }
.calc-key.is-policy-disabled { opacity: .18; filter: saturate(.15); }
.calc-key.is-emphasized:not(:disabled) { box-shadow: 0 0 0 2px rgba(255,159,10,.7), 0 0 24px rgba(255,159,10,.18); }
@media (max-width: 760px) {
  .tutorial-hub-intro { grid-template-columns: 1fr auto; }
  .tutorial-card-grid { grid-template-columns: 1fr; }
  .tutorial-guide-card { position: static; }
  .tutorial-layout { grid-template-columns: 1fr; }
  .tutorial-calculator-column { order: -1; }
}
@media (max-width: 480px) {
  .tutorial-hub-intro { grid-template-columns: 1fr; }
  .tutorial-progress-ring { width: 76px; height: 76px; justify-self: start; }
}
'''
# Remove obsolete tutorial styles to avoid conflicting sticky/order rules.
base_css = re.sub(r'\.tutorial-layout \{.*?\.tutorial-layout \.calculator \{ margin-top: 0; \}\n', '', base_css, flags=re.S)
# Remove obsolete media tutorial-specific lines, if present.
base_css = base_css.replace('  .tutorial-layout { grid-template-columns: 1fr; }\n  .tutorial-copy-card { position: static; }\n  .tutorial-layout .calculator { order: -1; }\n', '')
(new_pub/'style.css').write_text(base_css + '\n\n/* Online duel and ranking */\n' + online_css + new_tutorial_css)

# ---------- Integrate entry assets into existing root files ----------
root_index = (root/'public'/'index.html').read_text()
root_index = root_index.replace('  <link rel="stylesheet" href="/ten-freely-entry.css" />\n', '')
root_index = root_index.replace('  <script type="module" src="/ten-freely-entry.js"></script>\n', '')
(root/'public'/'index.html').write_text(root_index)
entry_css = (root/'public'/'ten-freely-entry.css').read_text()
root_style = (root/'public'/'style.css').read_text()
(root/'public'/'style.css').write_text(root_style + '\n\n/* 10を自由に：トップカードとゲスト案内 */\n' + entry_css)
entry_js = (root/'public'/'ten-freely-entry.js').read_text()
root_menu = (root/'public'/'menu-auth.js').read_text()
(root/'public'/'menu-auth.js').write_text(root_menu + '\n\n// 10を自由に：トップ導線（小規模なためメニュー処理へ統合）\n(() => {\n' + entry_js + '\n})();\n')

# ---------- Server consolidation under src/10を自由に ----------
# Storage combines the small session helper and game-specific Sheets adapter.
session = (root/'src'/'server'/'auth'/'session.js').read_text()
sheets = (root/'src'/'foundation'/'ten-freely-sheets.js').read_text()
session_body = session.replace('import crypto from "node:crypto";\n', '')
sheets_body = sheets.replace('import { SPREADSHEET_ID } from "./env.js";\nimport { getSheetsClient } from "./sheets.js";\n', '')
storage = 'import crypto from "node:crypto";\nimport { SPREADSHEET_ID } from "../foundation/env.js";\nimport { getSheetsClient } from "../foundation/sheets.js";\n\n' + session_body + '\n\n// Google Sheets persistence for this game.\n' + sheets_body
(new_src/'storage.js').write_text(storage)

# Shared problem generator remains a compact, separately testable module.
shutil.copy2(root/'src'/'server'/'ten-freely'/'problems.js', new_src/'problems.js')

# Solver doubles as its own worker entry, removing the tiny worker-only file.
solver = (root/'src'/'server'/'ten-freely'/'solver.js').read_text()
solver = solver.replace('../../../public/ten-freely/expression-engine.js', '../../public/10を自由に/expression-engine.js')
solver = 'import { isMainThread, parentPort } from "node:worker_threads";\n' + solver
solver += '''\n\nif (!isMainThread && parentPort) {\n  parentPort.on("message", (problem) => {\n    try { parentPort.postMessage({ ok: true, solution: solveTenProblem(problem) }); }\n    catch (error) { parentPort.postMessage({ ok: false, error: error?.message || String(error) }); }\n  });\n}\n'''
(new_src/'solver.js').write_text(solver)

server_index = (root/'src'/'server'/'ten-freely'/'index.js').read_text()
server_index = server_index.replace('../../../public/ten-freely/expression-engine.js', '../../public/10を自由に/expression-engine.js')
server_index = server_index.replace('../../foundation/sheets.js', '../foundation/sheets.js')
server_index = server_index.replace('''import {\n  appendTenFreelySoloResult,\n  getTenFreelyRanking,\n} from "../../foundation/ten-freely-sheets.js";''', '''import {\n  appendTenFreelySoloResult,\n  getTenFreelyRanking,\n} from "./storage.js";''')
server_index = server_index.replace('''import {\n  clearUserSessionCookie,\n  readUserSession,\n  requireUserSession,\n  setUserSessionCookie,\n} from "../auth/session.js";''', '''import {\n  clearUserSessionCookie,\n  readUserSession,\n  requireUserSession,\n  setUserSessionCookie,\n} from "./storage.js";''')
server_index = server_index.replace('new URL("./solution-worker.js", import.meta.url)', 'new URL("./solver.js", import.meta.url)')
(new_src/'index.js').write_text(server_index)

server_online = (root/'src'/'server'/'ten-freely'/'online.js').read_text()
server_online = server_online.replace('../../../public