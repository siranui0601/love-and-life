              <span id="guidanceDetail" class="sr-only"></span>
              <span id="guidanceKicker" class="sr-only">現在の目的</span>
            </button>
    
            <div id="quickMenu" class="quick-menu" hidden>
              <button type="button" data-open-panel="shop"><span aria-hidden="true">♙</span>店</button>
              <button type="button" data-open-panel="rumors"><span aria-hidden="true">◌</span>噂 <b id="rumorBadge">0</b></button>
              <button id="openChronicle" type="button" data-open-panel="chronicle"><span aria-hidden="true">▤</span>年代記</button>
