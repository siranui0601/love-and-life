              <button id="dialogueAdvance" class="dialogue-box" type="button" aria-describedby="advanceInstruction">
                <span id="dialogueSpeaker" class="dialogue-name" hidden></span>
                <span id="dialogueLine" class="dialogue-line">物語を読み込んでいます…</span>
                <span class="dialogue-next" aria-hidden="true">▼</span>
              </button>
              <span id="advanceInstruction" class="sr-only">次の文章へ進みます</span>
    
              <section id="decisionTray" class="decision-tray" aria-labelledby="choiceHeading" hidden>
                <h3 id="choiceHeading">どうする？</h3>
                <div id="choiceRegion" class="choices"></div>
              </section>
    
              <p id="outcomeToast" class="outcome-toast" hidden></p>
              <div id="gameError" class="error-box scene-error" role="alert" hidden></div>
              <p id="sceneAnnouncer" class="sr-only" aria-live="polite" aria-atomic="true"></p>
            </section>
    
            <aside id="tutorialCard" class="tutorial-coach" hidden>
              <span class="coach-arrow" aria-hidden="true"></span>
              <p id="tutorialBody"></p>
              <span id="tutorialTitle" class="sr-only">遊び方</span>
              <span id="tutorialProgress" class="sr-only" hidden></span>
              <button id="tutorialAction" type="button" hidden>確認する</button>
            </aside>
    
            <div id="saveIndicator" class="sr-only" data-status="saved">保存済み</div>
          </div>
        </section>
      </main>
    
      <dialog id="detailDialog" class="detail-dialog" aria-labelledby="dialogTitle" aria-busy="false">
        <div class="dialog-heading">
          <div><p id="dialogKicker" class="eyebrow">JOURNEY</p><h2 id="dialogTitle" tabindex="-1">詳細</h2></div>
