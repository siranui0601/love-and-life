              <div id="battleCommandMenu" class="battle-command-menu"></div>
            </section>
          </section>
        </div>
      </dialog>
    
      <div id="missionToastRegion" class="mission-toast-region" aria-label="ミッション通知"></div>
    
      <div id="busyOverlay" class="busy-overlay" role="status" aria-live="polite" aria-atomic="true" hidden>
