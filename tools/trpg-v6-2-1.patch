+    LOC_FARM_SQUARE: "届いた穀袋を共同倉庫の軒下まで運ぶ",
+    LOC_FARM_INN: "麦穂亭で皿洗いと薪運びを手伝う",
+    LOC_FARM_BAKERY: "粉袋と窯の薪を運ぶ",
+    LOC_FARM_WELL: "井戸から必要な家へ水桶を届ける",
+  }[facilityId] ?? "荷運びと片づけを手伝う";
+}
