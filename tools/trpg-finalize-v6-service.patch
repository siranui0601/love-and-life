+      type: "MISSION_HEAR_SATISFIED_BY_LOCAL_RUMOR",
+      minute: state.absoluteMinute,
+      missionId: definition.id,
+      troubleId: rumor.troubleId,
+      rumorId,
+    });
+    advanced.push(definition.id);
+  }
+  return advanced;
