  code: 'ERR_ASSERTION'
  name: 'AssertionError'
  expected:
  actual: |-
    /* P0 corrections that preserve the existing tutorial and control hierarchy. */
    
    .mission-toast-region {
      position: fixed;
      z-index: 1200;
      top: calc(env(safe-area-inset-top, 0px) + 68px);
      right: 10px;
      display: grid;
      width: min(320px, calc(100vw - 20px));
      gap: 6px;
      pointer-events: none;
    }
    
    .mission-lifecycle-toast {
      display: grid;
      width: 100%;
      gap: 2px;
      padding: 9px 11px;
      border: 1px solid rgba(225, 232, 239, 0.58);
      border-left: 3px solid #d6b964;
      border-radius: 6px;
      color: #f7f2df;
      background: rgba(9, 28, 46, 0.96);
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.34);
      text-align: left;
      opacity: 0;
      transform: translate3d(10px, -4px, 0);
      transition: opacity 160ms ease, transform 180ms ease;
      pointer-events: auto;
      cursor: pointer;
    }
    
    .mission-lifecycle-toast.is-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
    
    .mission-lifecycle-toast.is-complete,
    .mission-lifecycle-toast.is-rescue {
      border-left-color: #8cc9a4;
    }
    
    .mission-lifecycle-toast.is-failed {
      border-left-color: #cf827d;
    }
    
    .mission-toast-kicker {
      color: #dfc773;
      font-size: 0.61rem;
      font-weight: 900;
      letter-spacing: 0.14em;
    }
    
    .mission-lifecycle-toast strong {
      color: #fff;
      font-size: 0.86rem;
      line-height: 1.3;
    }
    
    .mission-toast-detail {
      color: rgba(241, 245, 248, 0.78);
      font-size: 0.7rem;
      line-height: 1.45;
    }
    
    .mission-lifecycle-toast:focus-visible {
      outline: 3px solid #fff4b7;
      outline-offset: 2px;
    }
    
    /* During the contextual skill lesson, the existing skill icon remains the only call to action. */
    .decision-tray.is-context-tutorial-paused .choice-button[data-p0-tutorial-locked="true"] {
      opacity: 0.34;
      filter: saturate(0.35);
    }
    
    /* The former mobile height cap clipped the second row of battle commands. */
    @media (max-width: 720px) {
      .battle-dialog[open] {
        overflow: hidden;
      }
    
      .battle-dialog .battle-message {
        min-height: 0;
        padding-bottom: max(14px, env(safe-area-inset-bottom, 0px));
      }
    
      .battle-dialog .battle-command-panel:not([hidden]) {
        display: block;
        max-height: min(42dvh, 240px) !important;
        overflow-y: auto !important;
        overscroll-behavior: contain;
        scrollbar-gutter: stable;
        -webkit-overflow-scrolling: touch;
      }
    
      .battle-dialog .battle-command-menu[data-mode="root"] {
        min-height: 108px;
        overflow: visible;
      }
    
      .battle-dialog .battle-command-menu[data-mode="skills"] {
        max-height: min(32dvh, 210px);
        overflow-y: auto;
        overscroll-behavior: contain;
      }
    
      .battle-dialog .battle-command-button {
        min-height: 48px;
      }
    
      .mission-toast-region {
        top: calc(env(safe-area-inset-top, 0px) + 56px);
        right: 7px;
        width: min(310px, calc(100vw - 14px));
      }
    }
    
    @media (max-height: 620px) and (max-width: 720px) {
      .battle-dialog .battle-command-panel:not([hidden]) {
        max-height: min(38dvh, 190px) !important;
      }
    
      .battle-dialog .battle-command-menu[data-mode="skills"] {
        max-height: min(28dvh, 155px);
      }
    }
    
    @media (prefers-reduced-motion: reduce) {
      .mission-lifecycle-toast {
        transition: none;
      }
    }
    
