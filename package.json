{
  "name": "summer-love-game",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "trpg:test": "node --test tools/trpg-sim/test/*.test.mjs",
    "trpg:check": "npm run trpg:test",
    "trpg:simulate": "npm run trpg:test && node tools/trpg-sim/cli.mjs",
    "trpg:player-simulate": "npm run trpg:test && node tools/trpg-sim/cli-player.mjs",
    "trpg:player-simulate:v2": "npm run trpg:test && node tools/trpg-sim/cli-player.mjs",
    "trpg:preview": "node tools/trpg-sim/static-server.mjs"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^2.1.0",
    "@google/generative-ai": "*",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "googleapis": "^105.0.0",
    "socket.io": "^4.7.5"
  }
}
